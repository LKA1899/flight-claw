# FlightClaw 生产环境配置
# 复制此文件为 .env.production 并修改

# LLM 配置 (可选 — 用于 AI 报告分析)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 通知配置 (可选)
# PushPlus: https://www.pushplus.plus/
PUSHPLUS_TOKEN=
# 企业微信 Webhook
WEWORK_WEBHOOK_URL=

# CORS 配置 (通常不需要修改 — nginx 反向代理下为同源请求)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 登录安全配置 (生产环境必须修改)
SECRET_KEY=change-me-please-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 默认管理员 (首次启动时初始化，已存在用户时不覆盖)
ADMIN_USERNAME=LK-fscan
ADMIN_PASSWORD=Fs@2026#R7xQ9mP2
